APP_NAME=ROOM_0
ENVIRONMENT=development
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET_KEY=replace-with-strong-secret
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_BOT_USERNAME=room0bot
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_APP_URL=https://your-domain.example
TELEGRAM_ALLOWED_ORIGINS=https://your-domain.example,https://*.telegram.org

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/room0
REDIS_URL=redis://localhost:6379/0

LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

CORS_ORIGINS=http://localhost:5173,https://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=room0admin

ENABLE_LIVEKIT=false
ENABLE_DEMO_MODE=true
ENABLE_REWARDS=false
BACKUP_DIR=./backups
